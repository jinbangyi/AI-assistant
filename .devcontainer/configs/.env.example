# Environment Variables for AI Assistant Development Container
# Copy this file to .env in the .devcontainer directory and update with your actual values
# Note: .env should remain in .devcontainer/ (not in configs/) for docker-compose to automatically load it

# ============================================
# Dify Configuration
# ============================================
DIFY_SECRET_KEY=sk-xxxxx

# ============================================
# Open WebUI Configuration
# ============================================
WEBUI_SECRET_KEY=secret-key-change-in-production
OPENAI_API_BASE_URL=
DEFAULT_MODELS=gpt-3.5-turbo,gpt-4

# ============================================
# LiteLLM Configuration
# ============================================
# Master key for LiteLLM authentication
LITELLM_MASTER_KEY=sk-1234

# Database password for LiteLLM PostgreSQL
LITELLM_DB_PASSWORD=litellm_password

# API Keys for LLM providers (set these to use the models)
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Custom database URL (if not using the containerized database)
# LITELLM_DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: Custom Redis URL (if not using the containerized Redis)
# LITELLM_REDIS_URL=redis://host:6379

# ============================================
# n8n Configuration
# ============================================
N8N_POSTGRES_PASSWORD=n8n_password

# ============================================
# SigNoz Configuration
# ============================================
# SigNoz version (optional, defaults to v0.97.0)
SIGNOZ_VERSION=v0.97.0

# OpenTelemetry Collector tag (optional, defaults to v0.129.7)
OTELCOL_TAG=v0.129.7
